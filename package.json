{
  "name": "mythweaver",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted, multi-user platform for solo tabletop role-playing.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @mythweaver/api --filter @mythweaver/web dev",
    "dev:api": "pnpm --filter @mythweaver/api dev",
    "dev:web": "pnpm --filter @mythweaver/web dev",
    "build": "pnpm --filter @mythweaver/api --filter @mythweaver/web build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @mythweaver/api db:generate",
    "db:migrate": "pnpm --filter @mythweaver/api db:migrate",
    "stack:up": "docker compose up --build",
    "stack:down": "docker compose down",
    "admin:bootstrap": "pnpm --filter @mythweaver/api admin:bootstrap",
    "test:integration": "pnpm --filter @mythweaver/api test:integration"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
