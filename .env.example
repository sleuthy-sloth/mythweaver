# Copy to .env and adjust. Never commit .env.
# Used by the API when run directly (`pnpm dev:api`) and by Compose.

NODE_ENV=development
API_PORT=8080
API_HOST=0.0.0.0
LOG_LEVEL=debug

# Host port 55432 avoids the machine-wide Postgres already on 5432.
POSTGRES_USER=mythweaver
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=mythweaver
POSTGRES_HOST_PORT=55432

# API -> database. Compose overrides the host with `db`.
DATABASE_URL=postgres://mythweaver:change-me-local-only@127.0.0.1:55432/mythweaver

# Comma-separated browser origins allowed to call the API directly.
# Empty means same-origin only (the web container proxies /api).
CORS_ORIGINS=

# Exposed to the Vite dev server only.
VITE_API_BASE_URL=/api/v1

# --- Identity ---
# Registration is closed by default. Create the first account with:
#   pnpm admin:bootstrap --email you@example.com --name "Your Name"
REGISTRATION_OPEN=false
SESSION_TTL_DAYS=30
# auto = Secure when NODE_ENV=production. Set false only for plain-HTTP development.
COOKIE_SECURE=auto
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_MAX=5
